PORT=3001
NODE_ENV=production
PUBLIC_BASE_URL=https://hidepdfcontent.com

# Required in production. Send as X-API-Key or Authorization: Bearer <key>
# The hosted playground does not need a key — same-origin browser requests are allowed.
API_KEY=change-me

# Optional. Set this when the API is listed on RapidAPI.
# RAPIDAPI_PROXY_SECRET=

MAX_FILE_SIZE_MB=25
